   }
   pid_t pid1,pid2;
   printf("Parent process\n");
   pid1=fork();
   if(pid1==0){
      printf("p2:child of P1\n PID=%d\t ParentID=%d sumof odd numbers:%d\n",getpid(),getppid(),sumofoddnum(num));
   }
   else if(pid1<0){
      printf("P1 failed");
