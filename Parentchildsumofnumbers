#include<stdio.h>
#include<unistd.h>
#include<sys/wait.h>
#include<sys/types.h>

int sumofoddnum(int num){
   int sum=0;
   int i;
   for( i=1;i<=num;i=i+2){
      sum=sum+i;
   }
   return sum;
}
int sumofevennum(int num){
   int sum1=0;
   int i;
   for( i=0;i<=num;i=i+2){
      sum1=sum1+i;
   }
   return sum1;
}
int sumofnum(int num){
   int sum2=0;
   int i;
   for(i=0;i<=num;i++){
      sum2=sum2+i;
   }
   return sum2;
}
