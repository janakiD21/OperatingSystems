#include<stdio.h>
#include<unistd.h>
#include<sys/wait.h>
#include<sys/types.h>
int main(){
   pid_t pid1,pid2;
   printf("P1.parent process,PID=%d\n",getpid());
   pid1=fork();
   if(pid1==0)
   {
      printf("P2:child of P1,PID=%d,parentPID=%d\n",getpid(),getppid());
      pid2=fork();
      if(pid2==0)
      {
	 printf("P3:child of p2,PID=%d,parentPID=%d\n",getpid(),getppid());
      }
      else if(pid2>0){
	 wait(NULL);
	 printf("P2:child process of P3 completed\n");
      }
      else{
	 printf("Fork1 failed");
      }
   }
      else if(pid1>0){
	 wait(NULL);
	 printf("P1:child process P2 completed:\n");
      }
      else{
	 printf("fork failed");
      }
  
   return 0;
}
