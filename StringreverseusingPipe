#include <stdio.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <string.h>
#include <stdlib.h>
#include <ctype.h>

int main() {
    int pipe1[2]; 
    int pipe2[2]; 
    pid_t p2;
    char buffer[100];
    char result_str[100];
    int i, sum, len;

    /* Create two pipes */
    if (pipe(pipe1) == -1 || pipe(pipe2) == -1) {
        printf("Pipe creation failed\n");
        return 1;
    }

    p2 = fork();

    if (p2 < 0) {
        printf("Child process creation failed\n");
        return 1;
    }

    if (p2 > 0) {
        /* --- Parent Process (P1) Logic --- */
        close(pipe1[0]); /* Close read end of pipe 1 */
        close(pipe2[1]); /* Close write end of pipe 2 */

        printf("P1: Process ID: %d\n", getpid());
        printf("P1: Child Process ID: %d\n\n", p2);

        /* Round 1: Sum of Digits */
        printf("P1: Round 1: Enter a number for sum of digits: ");
        fgets(buffer, sizeof(buffer), stdin);
        buffer[strcspn(buffer, "\n")] = 0; // Remove newline
        write(pipe1[1], buffer, strlen(buffer) + 1);

        read(pipe2[0], buffer, sizeof(buffer));
        printf("P1: Received Sum of Digits from P2: %s\n", buffer);

        /* Round 2: Reverse String */
        printf("\nP1: Round 2: Enter a string to reverse: ");
        fgets(buffer, sizeof(buffer), stdin);
        buffer[strcspn(buffer, "\n")] = 0; // Remove newline
        write(pipe1[1], buffer, strlen(buffer) + 1);

        read(pipe2[0], buffer, sizeof(buffer));
        printf("P1: Received Reversed String from P2: %s\n", buffer);

        close(pipe1[1]);
        close(pipe2[0]);
        wait(NULL); // Wait for child to finish
    }
    else {
        close(pipe1[1]); 
        close(pipe2[0]); 
        read(pipe1[0], buffer, sizeof(buffer));
        printf("\n\tP2: Process ID: %d\n", getpid());
        printf("\tP2: Parent Process ID: %d\n", getppid());
        sum = 0;
        for (i = 0; buffer[i] != '\0'; i++) {
            if (isdigit(buffer[i])) {
                sum += (buffer[i] - '0');
            }
        }
        sprintf(result_str, "%d", sum);
        write(pipe2[1], result_str, strlen(result_str) + 1);
        read(pipe1[0], buffer, sizeof(buffer));
        len = strlen(buffer);
        for (i = 0; i < len / 2; i++) {
            char temp = buffer[i];
            buffer[i] = buffer[len - 1 - i];
            buffer[len - 1 - i] = temp;
        }
        write(pipe2[1], buffer, strlen(buffer) + 1);

        close(pipe1[0]);
        close(pipe2[1]);
        exit(0);
    }

    return 0;
}



