#include <stdio.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <string.h>
#include <ctype.h>
int main() {
    pid_t p2, p3;
    int pipe1[2], pipe2[2];
    char input[100], extracted[81];
    int i, len, vowels, is_pal;
    char *start, *end;
    if (pipe(pipe1) == -1 || pipe(pipe2) == -1) {
        printf("Pipe creation failed\n");
        return 1;
    }
    p2 = fork();
    if (p2 < 0) {
        printf("P2 creation failed\n");
    } 
    else if (p2 == 0) {
       p3 = fork();
        if (p3 < 0) {
            printf("P3 creation failed\n");
        } 
        else if (p3 == 0) {
            char p3_str[100];
            read(pipe2[0], p3_str, sizeof(p3_str));
            close(pipe2[0]);
            printf("\nP3\n");
            printf("p3 Successfully created\n");
            printf("PID=%d\n", getpid());
            printf("PPID=%d\n", getppid());
            len = strlen(p3_str);
            is_pal = 1;
            for(i = 0; i < len/2; i++) {
                if(p3_str[i] != p3_str[len - 1 - i]) {
                    is_pal = 0;
                    break;
                }
            }
            if(is_pal) printf("Result: \"%s\" is a palindrome.\n", p3_str);
            else printf("Result: \"%s\" is not a palindrome.\n", p3_str);
            
            return 0;
        } 
        else {
            char p2_str[100];
            close(pipe1[1]);
            read(pipe1[0], p2_str, sizeof(p2_str));
            close(pipe1[0]);
	    printf("\nP2\n");
            printf("p2 Successfully created\n");
            printf("PID=%d\n", getpid());
            printf("PPID=%d\n", getppid());
            vowels = 0;
            for(i = 0; p2_str[i] != '\0'; i++) {
                char c = tolower(p2_str[i]);
                if(c=='a'||c=='e'||c=='i'||c=='o'||c=='u') vowels++;
            }
            printf("Vowel count: %d\n", vowels);
            close(pipe2[0]);
            write(pipe2[1], p2_str, strlen(p2_str) + 1);
            close(pipe2[1]);
            wait(NULL);
            return 0;
        }
    } 
    else {
        printf("Enter string within brackets: ");
        fgets(input, sizeof(input), stdin);
        input[strcspn(input, "\n")] = '\0';
        start = strchr(input, '[');
        end = strrchr(input, ']');
        if (start && end && end > start) {
            len = end - start - 1;
            if (len > 80) len = 80;
            strncpy(extracted, start + 1, len);
            extracted[len] = '\0';
        } else {
            strncpy(extracted, input, 80);
            extracted[80] = '\0';
        }
        close(pipe1[0]);
        write(pipe1[1], extracted, strlen(extracted) + 1);
        close(pipe1[1]);
        wait(NULL); 
        printf("\nP1\n");
        printf("p1 Successfully created\n");
        printf("PID=%d\n", getpid());
        printf("PPID=%d\n", getppid());
    }
    return 0;
}



