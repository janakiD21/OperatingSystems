int main() {
    struct Process p[20];
    int n, i, choice;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        p[i].pid = i + 1;
        printf("P[%d] AT & BT: ", i + 1);
        scanf("%d %d", &p[i].at, &p[i].bt);
    }

    while (1) {
        printf("\n--- Scheduling Menu ---\n");
        printf("1. FCFS\n2. SJF\n3. SRTF\n4. Exit\nChoice: ");
        scanf("%d", &choice);

        if (choice == 1) fcfs(p, n);
        else if (choice == 2) sjf(p, n);
        else if (choice == 3) srtf(p, n);
        else break;
    }
    return 0;
}

