#ifndef HEAD_H
#define HEAD_H

struct Process {
    int pid;
    int at;  /* Arrival Time */
    int bt;  /* Burst Time */
    int temp_bt; /* For SRTF remaining time */
    int ct;  /* Completion Time */
    int tat; /* Turnaround Time */
    int wt;  /* Waiting Time */
};

void fcfs(struct Process p[], int n);
void sjf(struct Process p[], int n);
void srtf(struct Process p[], int n);

#endif

#include <stdio.h>
#include "head.h"

void fcfs(struct Process p[], int n) {
    int i;
    float avg_wt = 0, avg_tat = 0;

    /* Completion Time Calculation */
    p[0].ct = p[0].at + p[0].bt;
    for (i = 1; i < n; i++) {
        if (p[i].at > p[i - 1].ct)
            p[i].ct = p[i].at + p[i].bt;
        else
            p[i].ct = p[i - 1].ct + p[i].bt;
    }

    printf("\n--- FCFS Results ---\nProcess\tAT\tBT\tCT\tTAT\tWT\n");
    for (i = 0; i < n; i++) {
        p[i].tat = p[i].ct - p[i].at;
        p[i].wt = p[i].tat - p[i].bt;
        avg_tat += p[i].tat;
        avg_wt += p[i].wt;
        printf("P[%d]\t%d\t%d\t%d\t%d\t%d\n", p[i].pid, p[i].at, p[i].bt, p[i].ct, p[i].tat, p[i].wt);
    }
    printf("Avg TAT: %.2f, Avg WT: %.2f\n", avg_tat / n, avg_wt / n);
}

void sjf(struct Process p[], int n) {
    int count = 0, time = 0, i, shortest, min_bt;
    int is_completed[20];
    float avg_wt = 0, avg_tat = 0;

    for (i = 0; i < n; i++) is_completed[i] = 0;

    printf("\n--- SJF (Non-Preemptive) Results ---\n");
    while (count != n) {
        shortest = -1;
        min_bt = 9999;
        for (i = 0; i < n; i++) {
            if (p[i].at <= time && is_completed[i] == 0) {
                if (p[i].bt < min_bt) {
                    min_bt = p[i].bt;
                    shortest = i;
                }
            }
        }
        if (shortest == -1) {
            time++;
        } else {
            p[shortest].ct = time + p[shortest].bt;
            p[shortest].tat = p[shortest].ct - p[shortest].at;
            p[shortest].wt = p[shortest].tat - p[shortest].bt;
            avg_tat += p[shortest].tat;
            avg_wt += p[shortest].wt;
            is_completed[shortest] = 1;
            time = p[shortest].ct;
            count++;
        }
    }
    printf("Process\tAT\tBT\tCT\tTAT\tWT\n");
    for (i = 0; i < n; i++)
        printf("P[%d]\t%d\t%d\t%d\t%d\t%d\n", p[i].pid, p[i].at, p[i].bt, p[i].ct, p[i].tat, p[i].wt);
